{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "2-Pyramid",
  "version": "2.0.4",
  "identifier": "com.2pyrstudio.2pyrdesktop",
  "build": {
    "beforeDevCommand": "vite --port 1421",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.2pyr/**"
        ]
      },
      "csp": "default-src 'self'; connect-src 'self' https://api.github.com https://github.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:;",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "UImage/**/*",
      "overlay/**/*"
    ]
  },
  "plugins": {
    "dialog": null,
    "notification": null
  }
}
