{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "2-Pyramid",
  "version": "2.0.0",
  "identifier": "com.2pyrstudio.2pyrdesktop",
  "build": {
    "beforeDevCommand": "vite --port 1421",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build && cargo build --manifest-path src-tauri/Cargo.toml -p two_pyramid_shell --release",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "2-Pyramid",
        "width": 1200,
        "height": 750,
        "decorations": false,
        "transparent": true,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnTop": false,
        "focus": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.github.com https://github.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: https://asset.localhost data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "UImage/**/*",
      "overlay/**/*",
      "target/release/two_pyramid_shell.dll"
    ]
  },
  "plugins": {
    "dialog": null,
    "notification": null
  }
}
